# Variáveis de Ambiente — AI Recruitment Pipeline
# Copie este arquivo para .env e preencha os valores

# =============================================================================
# BANCO DE DADOS
# =============================================================================
POSTGRES_USER=recrut
POSTGRES_PASSWORD=recrut_password
POSTGRES_DB=recruitment_db
POSTGRES_PORT=5432

DATABASE_URL="postgresql://recrut:recrut_password@localhost:5432/recruitment_db?schema=public"

# =============================================================================
# BACKEND (NestJS)
# =============================================================================
NODE_ENV=development
BACKEND_PORT=3001

# JWT (prepare para autenticação futura)
JWT_SECRET=change_this_to_a_strong_secret_in_production

# =============================================================================
# FRONTEND (Next.js)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME="AI Recruitment Pipeline"

# =============================================================================
# IA — OPENAI
# =============================================================================
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TIMEOUT_MS=30000

# =============================================================================
# STORAGE (para uploads de currículo)
# =============================================================================
# Em desenvolvimento, arquivos ficam em disco local
# Em produção, configure um bucket S3 ou similar
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug
